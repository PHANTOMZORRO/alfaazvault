# ==============================================================================
# AlfaazVault Environment Configuration
# ==============================================================================

# Database connection
# LOCAL (SQLite):   DATABASE_URL="file:./dev.db"          (change prisma schema provider to "sqlite")
# PRODUCTION (PostgreSQL on Render / Neon / Supabase):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/alfaazvault?schema=public"

# Secret key used for signing session JWT tokens (change to a random string in production)
JWT_SECRET="alfaazvault_super_secret_jwt_sepolia_session_token_key_change_me"

# Deployed Smart Contract Address on Sepolia Testnet
# Fill this with the address obtained after deploying the AlfaazVault contract in Remix
NEXT_PUBLIC_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Sepolia RPC URL for backend on-chain access verification and receipt parsing
# You can use https://rpc.sepolia.org or your Infura/Alchemy endpoint
SEPOLIA_RPC_URL="https://rpc.sepolia.org"

# Sepolia Chain ID (11155111)
NEXT_PUBLIC_CHAIN_ID="11155111"
